# Copy to backend/.env. Only needed when running the backend outside Docker.
# With `docker compose up`, the root .env is used instead.
#
# Substitute the MONGO_USER / MONGO_PASSWORD values from your root .env.
MONGO_URI=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@127.0.0.1:27017/chatbot?authSource=admin
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Optional: Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
