# Copy to .env and fill in. Consumed by docker-compose.yml.
# Never commit .env — it is gitignored.

# Required for chat + document embedding
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

REDIS_URL=

# Signs auth tokens. Generate one: openssl rand -hex 32
JWT_SECRET=

# MongoDB Atlas connection string, including the database name.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatbot?retryWrites=true&w=majority
MONGO_URI=

# Optional: Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
