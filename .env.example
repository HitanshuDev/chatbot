# Copy to .env and fill in. Consumed by docker-compose.yml.
# Never commit .env — it is gitignored.

# Required for chat + document embedding
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Signs auth tokens. Generate one: openssl rand -hex 32
JWT_SECRET=

# Local Mongo credentials. Generate a password: openssl rand -hex 16
# These seed the database on first start, so set them before the first `up`.
MONGO_USER=
MONGO_PASSWORD=

# Optional: Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
